{
  "name": "dsh-sidebar-suite",
  "version": "0.2.4",
  "license": "MIT",
  "author": "Yonan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YONAN1269/dsh-sidebar-suite.git"
  },
  "homepage": "https://github.com/YONAN1269/dsh-sidebar-suite#readme",
  "bugs": {
    "url": "https://github.com/YONAN1269/dsh-sidebar-suite/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "description": "一款专门针对改进 DSH 左侧栏体验的插件：三种布局一键切换、默认布局在详情页顶部直接设、会话列表默认全展开、「临时会话」开原生会话且退出 / 每天定时自动删除、详情页三种反馈入口 —— 强实用性；界面沿用宿主原生配色、圆角与间距，只加属性与一条控制栏、不重构宿主结构 —— 克制美观。｜A plugin dedicated to the DSH sidebar experience: one-click layouts, always-expanded sessions, disposable native temp sessions and in-page settings/feedback — seriously practical; native colours, radii and spacing with zero host-DOM rewrites — restrained and good-looking.",
  "keywords": [
    "dsh-plugin",
    "dsh",
    "deepseek-harness",
    "sidebar",
    "layout",
    "temp-session",
    "privacy",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./DETAIL.md": "./DETAIL.md",
    "./assets/*": "./assets/*"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/temp-session-host.mjs",
    "temp-session-config.txt",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "DETAIL.md",
    "LICENSE",
    "assets/*.jpg",
    "assets/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
